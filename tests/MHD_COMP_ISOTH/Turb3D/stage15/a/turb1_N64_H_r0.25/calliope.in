! Stage 4 decaying isothermal MHD turbulence (gen_stage4.py turb)
&mpi_settings
  dim_decomp = 2
/
&box_parameters
  lx = 1.0d0
  ly = 1.0d0
  lz = 1.0d0
  nlx = 64
  nly = 64
  nlz = 64
  pruned = F
/
&time_parameters
  dt = 0.0013211070872959601d0
  nstep = 71340
  cfl = 0.5d0
  reset_method = 'track'
  increase_dt = 10000000000.0d0
  t_end = 6.283185307179586d0
/
&scheme_parameters
  time_step_scheme = 'eSSPIFRK3'
/
&operation_parameters
  nonlinear = T
/
&physical_parameters
  nu = 0.0d0
  nu_h = 2084.801514999393d0
  nu_h_exp = 4
  eta = 0.0d0
  eta_h = 2084.801514999393d0
  eta_h_exp = 4
  lmd = 0.0d0
  lmd_h = 2084.801514999393d0
  lmd_h_exp = 4
  beta0 = 2.0d0
  rho_min = 0.01d0
  shear = F
  q = 0.0d0
/
&numerics_parameters
  formulation = 'C'
  visc_form = 'flux'
  filter_lnrho = T
  filter_mom = T
  filter_mag = T
  cfl_visc = 1.0d0
  mass_correction = F
  s_abort = 100.0d0
  debug_nan_step = -1
/
&shock_parameters
  C_shock = 2.0d0
  shock_nmax = 1
  shock_nsmooth = 1
  shock_dl = 0.0d0
  shock_selftest = F
  C_eta = 0.0d0
/
&svv_parameters
  svv_eps0 = 0.0d0
  svv_mN = 0.5d0
  svv_above_kc = T
  svv_form = 'entropy'
  cfl_svv = 2.0d0
  svv_pi_init = 50
  svv_pi_check = 100
/
&isoth_diagnostics
  write_intvl_1D = 0.0d0
  write_intvl_cons = 0.0d0
  budget = T
  write_intvl_planes = 0.39269908169872414d0
/
&force
  driven = F
/
&terminate
  max_wall_time = 0.45d0
  terminate_file_name = 'terminate'
/
&diagnostics_parameters
  write_intvl = 10000000000.0d0
  write_intvl_2D = 0.0d0
  write_intvl_3D = 0.39269908169872414d0
/
&restart_parameters
  save_restart_intvl = 10000000000.0d0
  restart_dir = './restart/'
/
&initial_condition
  init_type = 'restart'
/
