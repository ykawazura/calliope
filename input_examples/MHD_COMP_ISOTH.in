!--------------------------------------------------!
!             INPUTS for MHD COMP ISOTH            !
!--------------------------------------------------!
&mpi_settings
  dim_decomp = 2
  !dim1 = 4 ! decomp will be (dim1, nproc/dim1)
           ! if this is empty, decomp will be (dim1, dim2)
           ! such that dim1 ~= dim2.
/

!==============================================================================
&box_parameters
  lx = 1.0 ! to be multiplied by 2pi
  ly = 1.0 ! to be multiplied by 2pi
  lz = 1.0 ! to be multiplied by 2pi

  nlx = 64
  nly = 64
  nlz = 64

  pruned = .false. ! .true. truncates every field, which requires filter_lnrho = .true.
                   ! (see numerics_parameters); the projection of ln(rho) does not conserve mass
/

!==============================================================================
&time_parameters
  dt    = 1.0d-2
  nstep = 2000
  cfl   = 0.5d0  ! dt_adv = cfl/sum_d max(|u_d| + c_f,d)/dl_d (sum over the directions with nl > 2)
  reset_method = 'multiply'  !'multiply'  => multiply by a factor of 0.5
                             !'decrement' => decrement the top integer of dt
                             !'stop'      => terminate the run
                             !'track'     => dt = track_safety*dt_cfl when dt_cfl < dt, and also when
                             !               dt < track_raise*dt_cfl at a step where lambda_svv is
                             !               converged (every svv_pi_check steps), rounded down to
                             !               track_digits significant digits
  track_safety = 0.8d0       !Used only by 'track'; 0 < track_raise < track_safety <= 1
  track_raise  = 0.7d0
  track_digits = 3           !dt does not take the round-off of dt_cfl, which depends on the decomposition
  increase_dt = 1e+0         !When max dt computed from the cfl condition is 
                             ! larger than this value, set dt = increase_dt.
                             ! With 'track', dt never exceeds increase_dt.
  ! t_end = 1.0d0            !The run stops when time reaches t_end (default: none; nstep is then an upper bound)

                             ! When the file 'dt_adjust' including a float number is created,
                             ! dt will be manually adjusted to that value while running.
/

!==============================================================================
&scheme_parameters
  time_step_scheme = 'eSSPIFRK3' ! only 'eSSPIFRK3' in this model
/

!==============================================================================
&operation_parameters
  nonlinear = T
/

!==============================================================================
&physical_parameters
  ! regular and hyper viscosity ~ nu*k^2 + nu_h*k^(2*nu_h_exp)
  nu        = 1d+0  ! regular viscosity
  nu_h      = 1d+3  ! hyper viscosity
  nu_h_exp  = 4
  ! regular and hyper resistivity ~ eta*k^2 + eta_h*k^(2*eta_h_exp)
  eta       = 1d+0  ! regular resistivity
  eta_h     = 1d+3  ! hyper resistivity
  eta_h_exp = 4

  ! regular and hyper diffusion ~ lmd*k^2 + lmd_h*k^(2*lmd_h_exp)
  ! acts on ln(rho) and does not conserve mass (a warning is printed when lmd or lmd_h /= 0)
  lmd       = 1d+0  ! regular diffusion
  lmd_h     = 1d+4  ! hyper diffusion
  lmd_h_exp = 4

  beta0  = 1.d+2

  ! shear parameters
  shear  = .false.
  q      = 0.d0
/

!==============================================================================
&numerics_parameters
  formulation  = 'C'     ! ds/dt = -(div m)/rho, dm/dt = -div[m u + (p + B^2/2 - q) I - B B] (only 'C')
  visc_form    = 'flux'  ! q = rho zeta div(u) on the grid, then FFT (only 'flux')
  filter_lnrho = .false. ! 2/3 filter on ln(rho) after each stage; .true. changes sum exp(s) (mass)
  filter_mom   = .true.  ! 2/3 filter on m after each stage
  filter_mag   = .true.  ! 2/3 filter on B after each stage
  cfl_visc     = 1.0d0   ! dt_visc = cfl_visc/(largest viscous rate); SSPRK3 is stable up to 2.51
  mass_correction = .false. ! uniform correction s(k=0) += ln(M0/M) after each step (logged in conservation.dat)
  s_abort      = 100.d0  ! stop when |ln(rho)| > s_abort (exp overflow guard)
  debug_nan_step = -1    ! > 0: inject a NaN at this step to test the abort
/

&shock_parameters
  C_shock       = 2.d0   ! zeta = C_shock Delta^2 S[max(0, -div u)]; 0 disables the shock viscosity
  shock_nmax    = 1      ! number of local-max passes (half width 1) in S
  shock_nsmooth = 1      ! number of [1,2,1]/4 passes in S
  shock_dl      = 0.d0   ! Delta; <= 0: min_d dl_d over the directions with nl > 2
  shock_selftest = .false.
/

&svv_parameters
  svv_eps0     = 0.5d0   ! spectral vanishing viscosity eps_d = svv_eps0 dl_d max(|u_d| + c_f,d); <= 0: off
  svv_mN       = 0.5d0   ! Q(|k_d|) = 0 for |k_d| <= svv_mN*k_c,d (k_c,d = 2/3 of the Nyquist wavenumber)
  svv_above_kc = .true.  ! Q = 1 (.true.) or 0 (.false.) for |k_d| >= k_c,d (only ln(rho) has such modes)
  svv_form     = 'entropy' ! rho, m: 'entropy' (flux form in the entropy variables, dE/dt <= 0 for any state)
                           !         or 'linear' (-lambda(k) on m and on rho; B always gets -lambda(k))
  cfl_svv      = 2.0d0   ! 'entropy': dt <= cfl_svv/lambda_svv, lambda_svv by the power method (eSSPIFRK3: 2.51)
  svv_pi_init  = 50      ! 'entropy': power iterations at the first step (one per step afterwards)
  svv_pi_check = 100     ! 'entropy': converged power method every svv_pi_check steps; stop if dt*lambda_svv > 2.51
/

&isoth_diagnostics
  write_intvl_1D   = 0.d0  ! out1d/line_*.dat along the first direction with nl > 2; <= 0: none
  write_intvl_cons = 0.d0  ! conservation.dat; 0: every step, < 0: none
  budget           = .false. ! budget.dat every step (extra FFTs)
/

!==============================================================================
&initial_condition
  !init_type = 'zero'
  !init_type = 'single_vortex'
  !init_type = 'OT2'
  init_type = 'random'
  !init_type = 'restart'
/

&initial_condition_params
  kmin = 0.d0  0.d0  0.d0
  kmax = 3.d0  3.d0  3.d0
  b0   = 0.d0  0.d0  1.d0     ! beta0*rho0/b0**2 will be the initial beta. 
  b1   = 1.d0  1.d0  1.d0
  u1   = 0.d0  0.d0  0.d0 
  rho0 = 1.d+0                ! beta0*rho0/b0**2 will be the initial beta.
  rho1 = 0.d+0
/

!==============================================================================
&force
  driven = T
  nk_stir = 12  !Number of independent driven Fourier modes
/

!vvvvvvvvvvvvvvvvvvv       drive mx       vvvvvvvvvvvvvvvvvvv
&stir_1
 field_name = 'mx' 
 mode_amplitude = 0.5         !Amplitude of Langevin antenna.
 mode_frequency = (0.9, -0.6) !Frequency of Langevin antenna.
 kx = 1
 ky = 0
 kz = 1
/
&stir_2
 field_name = 'mx' 
 mode_amplitude = 0.5         !Amplitude of Langevin antenna.
 mode_frequency = (0.9, -0.6) !Frequency of Langevin antenna.
 kx = 1
 ky = 0
 kz = -1
/
&stir_3
 field_name = 'mx' 
 mode_amplitude = 0.5         !Amplitude of Langevin antenna.
 mode_frequency = (0.9, -0.6) !Frequency of Langevin antenna.
 kx = 0
 ky = 1
 kz = 1
/
&stir_4
 field_name = 'mx' 
 mode_amplitude = 0.5         !Amplitude of Langevin antenna.
 mode_frequency = (0.9, -0.6) !Frequency of Langevin antenna.
 kx = 0
 ky = 1
 kz = -1
