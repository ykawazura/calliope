#------- Program execution -----------
module load intel/2025.1
module load fftw/3.3.10/oneapi2025.1
export LD_LIBRARY_PATH=/system/apps/rhel9/library/netcdf-c/4.9.3/oneapi2025.1/lib:$LD_LIBRARY_PATH
export I_MPI_OFI_PROVIDER=psm3

cd ${PBS_O_WORKDIR}
export I_MPI_DEBUG=4
mpirun ./calliope <calliope.in >calliope.out.std
